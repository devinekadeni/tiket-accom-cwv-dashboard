node_modules/
dist/
.env
.env.local

# pnpm falls back to a store inside the repo when it cannot reach the usual one
# in $HOME. Tens of thousands of files, and nothing that belongs in git.
.pnpm-store/

# Generated at build time from data/runs/*.json + data/crux.json, never committed.
src/generated/

# Fabricated preview data from `pnpm run sample`. Never real measurements.
data/sample/

# wrangler's scratch directory, written by `pages deploy`.
.wrangler/

.DS_Store
*.log
